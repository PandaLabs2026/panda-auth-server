<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PandaAuth.Tests</RootNamespace>
    <AssemblyName>PandaAuth.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PandaAuth.Server\PandaAuth.Server.csproj" />
  </ItemGroup>

  <ItemGroup><ProjectReference Include="../CloudConfig.JointFixture/CloudConfig.JointFixture.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../PandaAuth.ReadinessHarness/PandaAuth.ReadinessHarness.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../IdentityViewHost/PandaAuth.Server.IdentityViewHost.csproj" /></ItemGroup>
  <ItemGroup>
    <None Update="Fixtures/ProfileAvatar/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Explicit isolated joint lane; ordinary Auth profiles do not build Oasis. -->
  <ItemGroup Condition="'$(OasisIdentityJoint)' == 'true'">
    <ProjectReference Include="../../../panda-oasis-server/src/oasis/oasis.csproj" Aliases="OasisHost" />
    <ProjectReference Include="../../../panda-oasis-server/tests/oasis.tests/oasis.tests.csproj" Aliases="OasisFixtures" />
    <PackageReference Include="Microsoft.Playwright" VersionOverride="1.52.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(OasisIdentityJoint)' != 'true'">
    <Compile Remove="OasisIdentityJointTests.cs" />
  </ItemGroup>
</Project>
