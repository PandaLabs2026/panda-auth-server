<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>PandaAuth</title>
    <!-- 品牌资产走 /account/brand/*：公网 Caddy 只把 /account/* 等前缀分给 IDP，
         根路径 /brand/* 会落到门户 catch-all 而 404（见 Program.cs 的同名挂载注释）。 -->
    <link rel="icon" type="image/png" sizes="32x32" href="/account/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/account/brand/favicon-16.png" />
    <link rel="icon" type="image/x-icon" href="/account/brand/favicon.ico" />
    <link rel="apple-touch-icon" href="/account/brand/apple-touch-icon.png" />
    <style>
        /* Light default mirrors the light tokens in panda-auth/design/tokens.css. */
        :root { --pa-primary: #2E6F96; --pa-primary-hover: #25597A; --pa-on-primary: #FFFFFF; --pa-text: #2B3438; --pa-bg: #FAFAF8; --pa-surface: #FFFFFF; --pa-border: #DDE3E5; --pa-focus-ring: #2F6F4F; --muted: #58666C; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; min-height: 100svh; padding: clamp(16px, 4vw, 32px); display: flex; align-items: center; justify-content: center; background: var(--pa-bg); font-family: system-ui, "Segoe UI", "Microsoft YaHei", sans-serif; color: var(--pa-text); }
        .card { width: 100%; max-width: 24rem; background: var(--pa-surface); border: 1px solid var(--pa-border); border-radius: 14px; padding: clamp(20px, 5vw, 32px); overflow-wrap: anywhere; }
        .brand { display: flex; align-items: center; margin-bottom: 24px; }
        .brand img { width: auto; height: 36px; max-width: 100%; display: block; object-fit: contain; object-position: left center; }
        .brand h1 { font-size: 20px; margin: 0; color: var(--pa-primary); letter-spacing: .5px; }
        .brand small { color: #AAB5B1; font-size: 12px; }
        label { display: block; font-size: 13px; color: var(--muted); margin: 14px 0 6px; }
        input[type=text], input[type=password], input[type=email] { width: 100%; padding: 10px 12px; border: 1px solid var(--pa-border); border-radius: 8px; font-size: 14px; background: var(--pa-bg); color: var(--pa-text); }
        input:focus { outline: 2px solid var(--pa-focus-ring); border-color: transparent; }
        button { width: 100%; margin-top: 20px; padding: 11px 0; border: 0; border-radius: 8px; background: var(--pa-primary); color: var(--pa-on-primary); font-size: 15px; cursor: pointer; }
        button:hover { background: var(--pa-primary-hover); }
        .error { margin-top: 14px; color: #9E3030; font-size: 13px; background: #FFF3F3; border: 1px solid #D7AAAA; border-radius: 8px; padding: 10px 12px; }
        .validation-summary-valid { display: none; }
        footer { margin-top: 20px; text-align: center; color: var(--muted); font-size: 12px; }
        .notice { margin-top: 14px; color: #1f6f43; font-size: 13px; background: #f0f7f2; border: 1px solid #cde8d6; border-radius: 8px; padding: 10px 12px; }
        .footnote { margin-top: 16px; text-align: center; font-size: 13px; }
        .footnote a { color: var(--pa-primary); text-underline-offset: 3px; }
        h1 { margin: 0 0 20px; font-size: 24px; line-height: 1.35; }
        p { line-height: 1.7; }
        a { color: var(--pa-primary); }
        a:focus-visible, button:focus-visible { outline: 3px solid var(--pa-focus-ring); outline-offset: 3px; }
        .error:focus { outline: 2px solid var(--pa-focus-ring); outline-offset: 3px; }
        .error ul { padding-left: 20px; margin: 0; }
        code { overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <main class="card" aria-labelledby="identity-title">
        <div class="brand">
            <img src="/account/brand/pandaauth-logo-horizontal.png" alt="PandaAuth by PandaLabs" />
        </div>
        <h1 id="identity-title" tabindex="-1">@ViewData["Title"]</h1>
        @RenderBody()
        <footer>PandaAuth · 统一身份认证</footer>
    </main>
</body>
</html>
