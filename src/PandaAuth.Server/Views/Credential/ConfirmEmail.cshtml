@model PandaAuth.Server.Features.Account.ConfirmEmailViewModel
@{
    ViewData["Title"] = "确认邮箱";
}

<form asp-action="SendEmailConfirmation" asp-controller="Credential" method="post">
    <button type="submit">发送确认令牌</button>
</form>
<form asp-action="ConfirmEmail" asp-controller="Credential" method="post">
    <div asp-validation-summary="All" class="error"></div>
    @if (TempData["Info"] is string info)
    {
        <div class="notice">@info</div>
    }
    <label asp-for="Token">邮件中的确认令牌</label>
    <input asp-for="Token" type="text" autocomplete="one-time-code" />
    <button type="submit">确认邮箱</button>
</form>
