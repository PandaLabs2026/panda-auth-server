@model PandaAuth.Server.Features.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "重置密码";
}

<form asp-action="ResetPassword" asp-controller="Credential" method="post">
    <div asp-validation-summary="All" class="error"></div>
    @if (ViewData["Info"] is string info)
    {
        <div class="notice">@info</div>
    }
    <label asp-for="Email">注册邮箱</label>
    <input asp-for="Email" type="email" autocomplete="email" />
    <label asp-for="Token">邮件中的恢复令牌</label>
    <input asp-for="Token" type="text" autocomplete="one-time-code" autofocus />
    <label asp-for="NewPassword">新密码（至少 10 位，含大小写、数字与符号）</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
    <input asp-for="ReturnUrl" type="hidden" />
    <button type="submit">重置密码</button>
    <p class="footnote"><a asp-action="ForgotPassword" asp-controller="Credential">重新发送恢复令牌</a> · <a asp-action="Login" asp-controller="Account">返回登录</a></p>
</form>
