@model PandaAuth.Server.Features.Account.ChangeEmailViewModel
@{
    ViewData["Title"] = "更换邮箱";
}

<form asp-action="ChangeEmail" asp-controller="Credential" method="post">
    <div asp-validation-summary="All" class="error"></div>
    <input asp-for="ReturnUrl" type="hidden" />
    <label asp-for="NewEmail">新邮箱</label>
    <input asp-for="NewEmail" type="email" autocomplete="email" />
    <label asp-for="CurrentPassword">当前密码</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
    <button type="submit">发送新邮箱确认令牌</button>
</form>
