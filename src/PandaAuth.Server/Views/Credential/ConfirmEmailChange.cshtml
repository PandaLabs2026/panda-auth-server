@model PandaAuth.Server.Features.Account.ConfirmEmailChangeViewModel
@{
    ViewData["Title"] = "确认新邮箱";
}

<form asp-action="ConfirmEmailChange" asp-controller="Credential" method="post">
    <div asp-validation-summary="All" class="error" role="alert" tabindex="-1" autofocus="@(ViewData.ModelState.IsValid ? null : "autofocus")"></div>
    <input asp-for="NewEmail" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />
    <label asp-for="Token">发送到新邮箱的确认令牌</label>
    <input asp-for="Token" type="text" autocomplete="one-time-code" />
    <button type="submit">确认更换邮箱</button>
</form>
