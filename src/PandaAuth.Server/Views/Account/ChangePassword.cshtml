@model PandaAuth.Server.Features.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "修改密码";
}

<form asp-action="ChangePassword" asp-controller="Credential" method="post">
    <div asp-validation-summary="All" class="error"></div>
    <label asp-for="CurrentPassword">当前密码</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus />
    <label asp-for="NewPassword">新密码（至少 10 位，含大小写、数字与符号）</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
    <button type="submit">修改密码</button>
    <p class="footnote">修改成功后需使用新密码重新登录，所有已登录设备将被下线。</p>
</form>
