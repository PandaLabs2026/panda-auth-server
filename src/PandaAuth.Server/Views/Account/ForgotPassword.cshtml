@model PandaAuth.Server.Features.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "忘记密码";
}

<form asp-action="ForgotPassword" asp-controller="Credential" method="post">
    <div asp-validation-summary="All" class="error"></div>
    @if (ViewData["Info"] is string info)
    {
        <div class="notice">@info</div>
    }
    <label asp-for="Email">注册邮箱</label>
    <input asp-for="Email" type="email" autocomplete="email" autofocus />
    <button type="submit">发送验证码</button>
    <p class="footnote"><a asp-action="Login" asp-controller="Account">返回登录</a></p>
</form>
