@model PandaAuth.Server.Features.Account.LoginMfaChallengeViewModel
@{
    ViewData["Title"] = "安全验证";
}

<div id="login-mfa-challenge">
    <p class="error">无法完成安全验证：账号没有任何可用的验证方式（Passkey 已退役，且无未使用的恢复码）。</p>
    <p class="footnote">请联系管理员重置两步验证，重置后重新登录并绑定 TOTP 验证器。</p>
    <p class="footnote"><a href="/account/login">返回登录</a></p>
</div>
