{
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=panda_auth;Username=panda_auth;Password=CHANGE_ME_VIA_ENV"
  },
  "Auth": {
    "Issuer": "",
    "HttpsRequired": true,
    "CookieSecure": "SameAsRequest",
    "TenantRouting": {
      "Enabled": false,
      "Bindings": []
    },
    "RateLimit": {
      "IpPerMinute": 10,
      "AccountPerMinute": 5
    },
    "Keys": {
      "RotationIntervalDays": 90,
      "ValidityDays": 180
    },
    "Audit": {
      "RetentionDays": 90
    },
    "Seed": {
      "SessionState": {
        "Enabled": false,
        "AdminClientSecret": "",
        "MeClientSecret": ""
      },
      "Enabled": true,
      "Admin": {
        "Email": "admin@example.com",
        "Password": ""
      },
      "Me": {
        "Enabled": true,
        "ClientSecret": "",
        "RedirectUris": [
          "https://auth.example.com/me/callback/login/pandaauth",
          "http://localhost:9007/me/callback/login/pandaauth"
        ],
        "PostLogoutRedirectUris": [
          "https://auth.example.com/me/callback/logout/pandaauth",
          "http://localhost:9007/me/callback/logout/pandaauth"
        ]
      },
      "AdminWeb": {
        "Enabled": true,
        "ClientSecret": "",
        "RedirectUris": [
          "https://auth.example.com/admin/callback/login/pandaauth",
          "http://localhost:9006/admin/callback/login/pandaauth"
        ],
        "PostLogoutRedirectUris": [
          "https://auth.example.com/admin/callback/logout/pandaauth",
          "http://localhost:9006/admin/callback/logout/pandaauth"
        ]
      },
      "OasisWeb": {
        "Enabled": false,
        "ClientSecret": "",
        "RedirectUris": [
          "https://oasis.example.com/signin-oidc",
          "http://localhost:5000/signin-oidc"
        ],
        "PostLogoutRedirectUris": [ "https://oasis.example.com/" ]
      },
      "Demo": {
        "Enabled": false,
        "WebSecret": "",
        "ServiceSecret": ""
      }
    },
    "DataProtectionKeyPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
