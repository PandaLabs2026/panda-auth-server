# PandaAuth Server process configuration keys; deliberately no values.
# Production orchestration is owned by the PandaAuth coordinator. Use its
# protected secret source and deploy guide instead of sourcing this reference.
ASPNETCORE_ENVIRONMENT=
ASPNETCORE_URLS=
ASPNETCORE_FORWARDEDHEADERS_ENABLED=
ASPNETCORE_FORWARDEDHEADERS__KnownNetworks__0=
PANDA_AUTH_TENANT_NETWORK_MODE=
PANDA_AUTH_TRUSTED_PROXY=
ConnectionStrings__Default=
ConnectionStrings__Migration=
Auth__Issuer=
Auth__HttpsRequired=
Auth__CookieSecure=
Auth__DataProtectionKeyPath=
# Production requires Base64 encoding of 32 bytes; inject from a secret store.
Auth__Mfa__TotpEncryptionKey=
Auth__Audit__RetentionDays=
